# ---- Firebase Firestore (required for production / Vercel) ----
# From your Firebase service account JSON (Project settings > Service accounts >
# Generate new private key). Without these three, the app falls back to a local
# JSON file, which is fine for local dev but LOSES DATA on Vercel.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value EXACTLY as it appears in the JSON, in quotes.
# On Vercel, keep the literal \n characters — the app converts them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Admin session secret (recommended) ----
# Used to sign the admin JWT. Set any long random string in production.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
